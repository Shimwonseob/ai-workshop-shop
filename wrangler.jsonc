{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-workshop-shop",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-workshop-shop-db",
      "database_id": "3264aaa1-8301-449a-b490-77eab5a78d41",
      "migrations_dir": "migrations"
    }
  ]
}
